    "test:watch": "vitest",
    "build": "bb plugin build"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.47",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.1",
    "hono": "^4.13.9",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
